# 共享根目录。开发库、正式库分别放入 development/ 和 production/ 子目录。
# 不再使用 DATA_DIR，避免两个环境误连同一数据库。
DATA_ROOT=./data

# 首次创建初始账号和管理员级密码找回时使用，至少 20 位。
AUTH_SETUP_TOKEN=replace-with-a-long-random-one-time-token

# 配置后启用 DeepSeek 结构化解析；否则使用本地规则解析。
# Key 只保存在 .env.local，不要提交到 Git。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_TEXT_MODEL=deepseek-v4-flash
DEEPSEEK_VISION_MODEL=deepseek-v4-flash-vision-exp
